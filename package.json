{
  "name": "rite-client",
  "productName": "RITE Client",
  "version": "0.1.0",
  "description": "Cliente de Kirka.io para la comunidad competitiva de RITE",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "start:light": "electron . --rite-light",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "electron-builder",
    "build:light": "electron-builder --config electron-builder.light.js",
    "dist": "electron-builder --publish always",
    "publicar": "node scripts/publicar.js",
    "publicar:rust": "node scripts/publicar-rust.js",
    "licencias": "node scripts/licencias.js",
    "panel": "node scripts/panel.js",
    "panel:app": "electron scripts/panel-app.js",
    "kirka-nombres": "node scripts/kirka-nombres.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankzMX/RITEClient.git"
  },
  "author": "FRANKZ",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.25.10",
    "mediabunny": "^1.61.6",
    "webcrack": "^2.16.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.10",
    "mp4-muxer": "^5.2.2"
  },
  "rite": {
    "discordClientId": "1559050134937931838"
  }
}
